APP_NAME=ChatGPT Clone Backend
APP_ENV=development
DEBUG=true

CHAT_MAX_OUTPUT_TOKENS=512
CHAT_CONTEXT_TOKEN_BUDGET=4000
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5433/chatgpt_clone
TEST_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5433/chatgpt_clone_test

BACKEND_URL=http://localhost:8000

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=chatgpt_clone

